# Public browser configuration (never use a service-role/secret key here).
# Use the legacy anon JWT key for compatibility with the chat Edge Function.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge Function secret: set in Supabase, never in a VITE_ variable.
# LOVABLE_API_KEY=your-lovable-api-key
# SITE_URL=https://your-production-domain.com
